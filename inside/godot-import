#!/usr/bin/env bash
# Rebuild Godot's import cache. Needed after adding scripts, scenes or assets.
# Usage: godot-import
[ "${1:-}" = --help ] && { sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0; }  # its header, above, says how
set -u
[ $# -eq 0 ] || { echo "usage: godot-import" >&2; exit 2; }
exec "$(dirname "$(realpath "$0")")/door-request" import
